{
  "name": "pigsgottafly",
  "private": true,
  "description": "Pig's Gotta Fly: a personal VFR flight planner for the Athinai FIR (LGGG)",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "start": "vite build && tsx server/server.ts",
    "serve": "tsx server/server.ts",
    "build": "vite build",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.app.json && node node_modules/typescript7/bin/tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node --import tsx --test --test-concurrency=1 --test-timeout=300000 \"tests/e2e/*.e2e.test.mjs\"",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "ref": "tsx tools/build_ref.ts",
    "smoke": "tsx tools/smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": false
  }
}
