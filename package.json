{
  "name": "pigsgottafly",
  "private": true,
  "description": "Pig's Gotta Fly: MD4.2 nav log filler for VFR flights in Greece",
  "scripts": {
    "start": "node server/server.mjs",
    "stamp": "node tools/stamp.mjs",
    "test": "node tools/stamp.mjs --check && node --test tests/unit/",
    "test:e2e": "node tools/stamp.mjs --check && node --test --test-concurrency=1 tests/e2e/",
    "test:all": "npm test && npm run test:e2e"
  },
  "type": "commonjs"
}
